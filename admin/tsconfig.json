{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@convex/*": [
        "../convex/*"
      ],
      "convex/*": [
        "./node_modules/convex/*"
      ],
      "convex": [
        "./node_modules/convex"
      ],
      "@convex-dev/auth/providers/*": [
        "./node_modules/@convex-dev/auth/dist/providers/*"
      ],
      "@convex-dev/auth/*": [
        "./node_modules/@convex-dev/auth/*"
      ],
      "@convex-dev/auth": [
        "./node_modules/@convex-dev/auth"
      ],
      "@convex-dev/rate-limiter/*": [
        "./node_modules/@convex-dev/rate-limiter/*"
      ],
      "@convex-dev/rate-limiter": [
        "./node_modules/@convex-dev/rate-limiter"
      ],
      "@auth/core/*": [
        "./node_modules/@auth/core/*"
      ],
      "@auth/core": [
        "./node_modules/@auth/core"
      ],
      "resend/*": [
        "./node_modules/resend/*"
      ],
      "resend": [
        "./node_modules/resend"
      ]
    }
  },
  "include": [
    "../convex/_generated/api.d.ts",
    "../convex/_generated/dataModel.d.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
