{
  "name": "p-app-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "postbuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.cpSync('.next', 'dist', { recursive: true })\"",
    "build:web": "next build",
    "start": "next start --port 3001",
    "clean": "node -e \"['.next', 'dist', 'out'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\"",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "clsx": "^2.1.1",
    "convex": "^1.17.4",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.13",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
